# --- Application ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=

# --- Database ------------------------------------------------------------------
# Local quick start (SQLite + in-memory vector store):
DATABASE_URL=sqlite+aiosqlite:///./requirements_agent.db
DATABASE_AUTO_CREATE=true
# Production / docker-compose (PostgreSQL + pgvector, schema via Alembic):
# DATABASE_URL=postgresql+asyncpg://reqagent:change-me@localhost:5432/reqagent
# DATABASE_AUTO_CREATE=false
POSTGRES_USER=reqagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reqagent

# --- Auth ----------------------------------------------------------------------
# Must be >= 32 characters; required (non-default) when ENVIRONMENT=production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_MINUTES=60
BCRYPT_ROUNDS=12
# Optional: seed an admin at startup. Otherwise the first registered user becomes admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEFAULT_SIGNUP_ROLE=viewer

# --- AI providers ----------------------------------------------------------------
# offline = deterministic heuristic analyser (no network, no key)
LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# hashing = deterministic lexical embeddings (offline); openai = text-embedding-3-*
EMBEDDING_PROVIDER=hashing
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Changing the dimension requires a new migration and re-embedding all chunks.
EMBEDDING_DIMENSION=384
VECTOR_BACKEND=auto

# --- RAG / analysis tuning ---------------------------------------------------------
CHUNK_MAX_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
ANALYSIS_CONTEXT_TOKENS=6000
ANALYSIS_MAX_EVIDENCE=24
STRUCTURED_MAX_REPAIRS=2

# --- Rate limiting (per user, AI generation endpoints) -------------------------------
RATE_LIMIT_AI_CAPACITY=10
RATE_LIMIT_AI_REFILL_PER_MINUTE=10
